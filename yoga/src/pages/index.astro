---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Hero from "../components/sections/hero/Hero.astro";
---

<BaseLayout
  title="Nirvana Yoga Akademi | Dengeyi Adım Adım İnşa Et"
  description="Premium yoga programları, uzman eğitmenler, meditasyon, nefes çalışmaları ve bütünsel dönüşüm deneyimi."
>
  <Header />
  <main>
    <Hero />

    <section
      id="akademi"
      style="
        min-height: 55vh;
        display: grid;
        place-items: center;
        padding: 100px var(--page-gutter);
        text-align: center;
      "
    >
      <div>
        <p class="eyebrow">Birinci yapı taşı tamamlandı</p>
        <h2
          style="
            max-width: 720px;
            margin: 0;
            font-family: var(--font-display);
            font-size: clamp(2.8rem, 6vw, 5rem);
            font-weight: 400;
            line-height: 1;
          "
        >
          Sıradaki adım:
          gerçek görseller ve marka hikâyesi.
        </h2>
      </div>
    </section>
  </main>
</BaseLayout>
